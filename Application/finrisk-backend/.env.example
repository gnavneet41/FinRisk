# Copy this file to .env (in this finrisk-backend folder) and fill in your key.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/finrisk

# ---------- LLM ----------
# gemini (default when GEMINI_API_KEY is set) | openai_compatible | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried if the main model stays overloaded (503)
# GEMINI_FALLBACK_MODEL=

# Later, for Groq / OpenRouter / local Ollama etc.:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# true = if the LLM fails, agents use the rule-based fallback (recommended for demos)
LLM_FALLBACK=true
