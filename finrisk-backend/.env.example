# Copy this file to .env (inside finrisk-backend) and fill in the values.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/finrisk

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-this-to-a-long-random-string

# First administrator (created automatically on first start if no admin exists).
# If ADMIN_PASSWORD is empty, a temporary password is printed in the console.
ADMIN_EMAIL=admin@finrisk.local
ADMIN_PASSWORD=

# ---------- LLM ----------
# These are the defaults. The admin can change provider/model/limits in
# System > LLM without editing this file. API keys only ever live here.
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_KEY
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=
# GEMINI_MAX_OUTPUT_TOKENS=8192

# For LLM_PROVIDER=openai_compatible (Groq, OpenRouter, local Ollama...):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

LLM_FALLBACK=true
